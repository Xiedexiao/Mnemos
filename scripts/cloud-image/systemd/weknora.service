[Unit]
Description=Mnemos (docker compose)
Requires=docker.service mnemos-firstboot.service
After=docker.service network-online.target mnemos-firstboot.service
Wants=network-online.target
# 关键: Requires=mnemos-firstboot.service 让首启 init 失败时本服务也不启动,
# 避免 firstboot 没成功生成随机密钥就用 .env.example 默认明文密码把 postgres
# 数据卷初始化掉。mnemos-firstboot.service 在已初始化的实例上由
# ConditionPathExists=!/opt/WeKnora/.firstboot.done 跳过, 跳过 = 成功,
# 不会阻塞本服务后续重启。

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/WeKnora
ExecStart=@DOCKER_BIN@ compose -f docker/docker-compose.yml --env-file .env up -d
ExecStop=@DOCKER_BIN@ compose -f docker/docker-compose.yml --env-file .env down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
